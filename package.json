{
  "name": "cliffwatch-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p packages/cli/tsconfig.json",
    "build:dashboard": "npm run build && npm run build -w @cliffwatch/dashboard && node scripts/package-dashboard.mjs",
    "dev": "npm run dev -w @cliffwatch/dashboard",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/dashboard/tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "verify:package": "node scripts/verify-packed.mjs",
    "lint": "eslint .",
    "status": "node packages/cli/dist/cli.js status"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
