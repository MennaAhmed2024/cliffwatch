{
  "name": "quotadog-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p packages/cli/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "status": "node packages/cli/dist/cli.js status"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
