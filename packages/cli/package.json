    "./pacing-history": "./dist/core/pacing-history.js",
    "./notify": "./dist/core/notify.js",
    "./setup": "./dist/setup.js"
  },
  "files": [
    "dist",
    "dashboard",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "better-sqlite3": "^11.10.0",
