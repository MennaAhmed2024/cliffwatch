{
  "name": "cliffwatch",
  "version": "0.1.0",
  "description": "Know your AI limits before you hit them — local quota status, pacing, alerts and dashboard",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
